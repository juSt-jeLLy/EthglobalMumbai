# Definitive Flash API key (https://flash.definitive.fi/docs/getting-started)
DEFINITIVE_FLASH_API_KEY=

# Groq powers the untrusted tweet -> draft plan parser. The backend validates every draft against Flash.
GROQ_API_KEY=
# Optional; must support strict JSON-schema outputs.
GROQ_MODEL=openai/gpt-oss-20b

# Optional: once the unpacked extension id is stable, restrict backend CORS to it.
EXTENSION_ID=

# Intercepta (Web3 Antivirus) API key (https://intercepta.io), used for token and transaction security checks
INTERCEPTA_API_KEY=
