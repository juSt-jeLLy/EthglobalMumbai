# Definitive Flash API key (https://flash.definitive.fi/docs/getting-started)
DEFINITIVE_FLASH_API_KEY=

# Groq powers the untrusted tweet -> draft plan parser. The backend validates every draft against Flash.
GROQ_API_KEY=
# Optional; must support strict JSON-schema outputs.
GROQ_MODEL=openai/gpt-oss-20b

# Optional: once the unpacked extension id is stable, restrict backend CORS to it.
EXTENSION_ID=

# Optional. Public GoPlus token checks work without this; an access token may raise rate limits.
GOPLUS_ACCESS_TOKEN=

# Optional. How often the backend rechecks attested public Caller Card sources.
# Defaults to 15 minutes; never set below 60000 (one minute).
SOURCE_MONITOR_INTERVAL_MS=900000

# Required durable database. The backend will not start without it and never
# falls back to JSON files. For the local Docker service use the URL below.
DATABASE_URL=postgresql://plan_b:replace-with-local-password@localhost:54329/plan_b
DATABASE_SSL=false
DATABASE_POOL_MAX=10

# Optional World ID Proof of Human for Caller Card publishers. Leave unset for
# the normal local demo. Set WORLD_REQUIRE_CALLER_VERIFICATION=true only after
# the World Developer Portal values below are configured.
WORLD_APP_ID=
WORLD_RP_ID=
WORLD_RP_SIGNING_KEY=
WORLD_ACTION=planb-verified-caller-v1
# Use staging only with the World simulator; production requires real World ID.
WORLD_ENVIRONMENT=staging
WORLD_REQUIRE_CALLER_VERIFICATION=false
