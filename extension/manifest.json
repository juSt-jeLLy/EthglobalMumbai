{
  "manifest_version": 3,
  "name": "Plan B",
  "version": "3.0",
  "description": "Turn any X post into a validated, editable trading plan powered by Groq and Definitive Flash.",
  "host_permissions": [
    "http://*/*",
    "https://*/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "*://*.x.com/*",
        "*://x.com/*"
      ],
      "js": [
        "x-ticker-swap.js"
      ]
    },
    {
      "matches": [
        "*://*.x.com/*",
        "*://x.com/*"
      ],
      "js": [
        "vendor/solana-web3.bundle.js",
        "bridge.js"
      ],
      "world": "MAIN",
      "run_at": "document_start"
    }
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self';"
  },
  "web_accessible_resources": [
    {
      "resources": [
        "icons/tokens/*.png",
        "icons/chains/*.png"
      ],
      "matches": [
        "*://x.com/*",
        "*://*.x.com/*"
      ]
    }
  ],
  "icons": {
    "16": "images/icon16.png",
    "48": "images/icon48.png",
    "128": "images/icon128.png"
  }
}
